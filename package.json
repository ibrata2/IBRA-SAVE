{
  "name": "ibra-save",
  "productName": "IBRA SAVE",
  "version": "1.0.0",
  "description": "IBRA SAVE — الصق الرابط وحمّل. بدون إعلانات وبدون تتبع.",
  "main": "src/main.js",
  "author": "ابراهيم الخزرجي",
  "license": "MIT",
  "homepage": "https://t.me/ibraprogram",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibrata2/IBRA-SAVE.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ibraprogram.ibrasave",
    "productName": "IBRA SAVE",
    "copyright": "برمجة و تطوير ابراهيم الخزرجي",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "IBRA-SAVE-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IBRA SAVE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1025"
    },
    "publish": [{ "provider": "github", "owner": "ibrata2", "repo": "IBRA-SAVE", "releaseType": "release" }]
  }
}
